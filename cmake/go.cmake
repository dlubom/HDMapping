include_guard(GLOBAL)

# Official archives: https://go.dev/dl/?mode=json. No toolchain lookup with MCP OFF.
set(HDMAPPING_GO_VERSION "1.27.4")
set(HDMAPPING_GO_EXECUTABLE "" CACHE FILEPATH "Optional Go executable (must match the pinned version)")
option(HDMAPPING_GO_FORCE_DOWNLOAD "Use the pinned Go archive even when system Go matches" OFF)

string(TOLOWER "${CMAKE_HOST_SYSTEM_NAME}" _go_os)
if(_go_os STREQUAL "darwin")
    set(_go_os darwin)
elseif(NOT _go_os MATCHES "^(linux|windows)$")
    message(FATAL_ERROR "MCP: unsupported Go host ${CMAKE_HOST_SYSTEM_NAME}")
endif()
string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" _go_processor)
if(_go_processor MATCHES "^(arm64|aarch64)$")
    set(_go_arch arm64)
elseif(_go_processor MATCHES "^(amd64|x86_64)$")
    set(_go_arch amd64)
else()
    message(FATAL_ERROR "MCP: unsupported Go architecture ${CMAKE_HOST_SYSTEM_PROCESSOR}")
endif()
# A host Go compiler must not silently produce a different target than C++.
if(CMAKE_CROSSCOMPILING OR (APPLE AND CMAKE_OSX_ARCHITECTURES AND
   NOT CMAKE_OSX_ARCHITECTURES STREQUAL CMAKE_HOST_SYSTEM_PROCESSOR))
    message(FATAL_ERROR "MCP currently requires a native, single-architecture build")
endif()
set(_go_suffix "")
set(_go_archive_suffix "tar.gz")
if(WIN32)
    set(_go_suffix ".exe")
    set(_go_archive_suffix "zip")
endif()

if(NOT HDMAPPING_GO_FORCE_DOWNLOAD)
    if(HDMAPPING_GO_EXECUTABLE)
        set(_go_candidate "${HDMAPPING_GO_EXECUTABLE}")
    else()
        find_program(_go_candidate NAMES go NO_CACHE)
    endif()
    if(_go_candidate)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env GOTOOLCHAIN=local GOENV=off
            "${_go_candidate}" version OUTPUT_VARIABLE _go_version OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE _go_status)
        if(_go_status EQUAL 0 AND _go_version STREQUAL "go version go${HDMAPPING_GO_VERSION} ${_go_os}/${_go_arch}")
            set(HDMAPPING_GO "${_go_candidate}")
        elseif(HDMAPPING_GO_EXECUTABLE)
            message(FATAL_ERROR "MCP requires Go ${HDMAPPING_GO_VERSION} ${_go_os}/${_go_arch}; got ${_go_version}")
        endif()
    endif()
endif()

if(NOT HDMAPPING_GO)
    set(_go_hash_darwin_amd64 2b799377704ef12db39bd254995d5c348c9cc8d86562ca817724390e56c38f43)
    set(_go_hash_darwin_arm64 91a44a2b8a716600ad94a4f143e156116620db8828086a6e3602291be9bd0bb4)
    set(_go_hash_linux_amd64 7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840)
    set(_go_hash_linux_arm64 3392582988a273a87ab5043ee1b2c9c17a2c3c00580bf9326c47a2e0aaaeac92)
    set(_go_hash_windows_amd64 178ab98950ac69ab25069307dc6ade79f3816e414cce95b4da166a115cde1e7e)
    set(_go_hash_windows_arm64 9e7a72565792b8ab370b37ac9ac109799237abacb39ff2f541c438b963c0cc64)
    set(_go_root "${CMAKE_BINARY_DIR}/_deps/go-${HDMAPPING_GO_VERSION}-${_go_os}-${_go_arch}")
    set(_go_archive "${_go_root}/go${HDMAPPING_GO_VERSION}.${_go_os}-${_go_arch}.${_go_archive_suffix}")
    set(HDMAPPING_GO "${_go_root}/go/bin/go${_go_suffix}")
    if(NOT EXISTS "${HDMAPPING_GO}")
        file(MAKE_DIRECTORY "${_go_root}")
        file(DOWNLOAD "https://go.dev/dl/go${HDMAPPING_GO_VERSION}.${_go_os}-${_go_arch}.${_go_archive_suffix}"
            "${_go_archive}" EXPECTED_HASH "SHA256=${_go_hash_${_go_os}_${_go_arch}}" TLS_VERIFY ON)
        file(ARCHIVE_EXTRACT INPUT "${_go_archive}" DESTINATION "${_go_root}")
    endif()
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env GOTOOLCHAIN=local GOENV=off "${HDMAPPING_GO}" version
    OUTPUT_VARIABLE _go_version OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _go_status)
if(NOT _go_status EQUAL 0 OR NOT _go_version STREQUAL "go version go${HDMAPPING_GO_VERSION} ${_go_os}/${_go_arch}")
    message(FATAL_ERROR "MCP: invalid Go toolchain: ${_go_version}")
endif()
message(STATUS "MCP: ${_go_version} (${HDMAPPING_GO})")
set(HDMAPPING_GO_ENV "HDMAPPING_GO_EXECUTABLE=${HDMAPPING_GO}" GOTOOLCHAIN=local GOWORK=off GOENV=off GOFLAGS=-mod=readonly
    "GOOS=${_go_os}" "GOARCH=${_go_arch}" CGO_ENABLED=0
    "GOCACHE=${CMAKE_BINARY_DIR}/go-cache" "GOMODCACHE=${CMAKE_BINARY_DIR}/go-modules")
