include_guard(GLOBAL)

option(HDMAPPING_PROCESSING_WERROR "Treat warnings from processing targets as errors" ON)
option(HDMAPPING_PROCESSING_TIDY "Enable pinned clang-tidy analysis for processing targets" OFF)
set(HDMAPPING_PROCESSING_SANITIZER "none" CACHE STRING "Processing sanitizer: none, address-undefined or thread")
set_property(CACHE HDMAPPING_PROCESSING_SANITIZER PROPERTY STRINGS none address-undefined thread)

if(HDMAPPING_PROCESSING_SANITIZER STREQUAL "address-undefined")
    set(_processing_sanitizer address,undefined)
elseif(HDMAPPING_PROCESSING_SANITIZER STREQUAL "thread")
    set(_processing_sanitizer thread)
elseif(NOT HDMAPPING_PROCESSING_SANITIZER STREQUAL "none")
    message(FATAL_ERROR "Invalid processing sanitizer: ${HDMAPPING_PROCESSING_SANITIZER}")
endif()
if(_processing_sanitizer AND (MSVC OR NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang"))
    message(FATAL_ERROR "Processing sanitizers require a Clang compiler with GNU-style flags")
endif()

function(hdmapping_processing_target target)
    set_property(TARGET ${target} PROPERTY CXX_EXTENSIONS OFF)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /utf-8)
        if(HDMAPPING_PROCESSING_WERROR)
            target_compile_options(${target} PRIVATE /WX)
        endif()
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
        if(HDMAPPING_PROCESSING_WERROR)
            target_compile_options(${target} PRIVATE -Werror)
        endif()
    endif()

    if(_processing_sanitizer)
        target_compile_options(${target} PRIVATE -fsanitize=${_processing_sanitizer} -fno-sanitize-recover=all -fno-omit-frame-pointer -g)
        target_link_options(${target} PRIVATE -fsanitize=${_processing_sanitizer})
    endif()
endfunction()

if(HDMAPPING_PROCESSING_TIDY)
    if(NOT CMAKE_EXPORT_COMPILE_COMMANDS OR NOT CMAKE_GENERATOR MATCHES "Ninja|Makefiles")
        message(FATAL_ERROR "Processing clang-tidy requires a CMake compile database (Ninja or Makefiles)")
    endif()
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        set(_processing_tidy_version "18.1.3")
        find_program(HDMAPPING_PROCESSING_CLANG_TIDY NAMES clang-tidy-18 clang-tidy REQUIRED)
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
        set(_processing_tidy_version "22.1.8")
        find_program(HDMAPPING_PROCESSING_CLANG_TIDY NAMES clang-tidy REQUIRED)
        # AppleClang can select the SDK implicitly. Standalone LLVM must be
        # told the same SDK to find the C++ and platform system headers.
        if(IS_DIRECTORY "${CMAKE_OSX_SYSROOT}")
            set(_processing_tidy_sdk "${CMAKE_OSX_SYSROOT}")
        else()
            set(_processing_sdk_name "${CMAKE_OSX_SYSROOT}")
            if(NOT _processing_sdk_name)
                set(_processing_sdk_name macosx)
            endif()
            execute_process(COMMAND xcrun --sdk "${_processing_sdk_name}" --show-sdk-path
                OUTPUT_VARIABLE _processing_tidy_sdk OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
        endif()
        set(_processing_tidy_args "--extra-arg=-isysroot" "--extra-arg=${_processing_tidy_sdk}")
    else()
        message(FATAL_ERROR "Processing clang-tidy is qualified on Linux and macOS; use the Linux CI gate")
    endif()
    execute_process(COMMAND "${HDMAPPING_PROCESSING_CLANG_TIDY}" --version
        OUTPUT_VARIABLE _processing_tidy_banner COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "." "[.]" _processing_tidy_version_pattern "${_processing_tidy_version}")
    if(NOT _processing_tidy_banner MATCHES "version ${_processing_tidy_version_pattern}([^0-9.]|$)")
        message(FATAL_ERROR "Expected clang-tidy ${_processing_tidy_version}; got ${_processing_tidy_banner}")
    endif()
    message(STATUS "Processing analysis: ${HDMAPPING_PROCESSING_CLANG_TIDY} ${_processing_tidy_version}")
endif()
